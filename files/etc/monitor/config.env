TELEGRAM_TOKEN="YOUR_TOKEN"
TELEGRAM_CHAT_ID="YOUR_CHAT_ID"
TELEGRAM_USER_ID="YOUR_USER_ID"

SECRET="CHANGE_ME"

ALLOWLIST="/etc/monitor/mac_allowlist"
BLOCKLIST="/etc/monitor/mac_blocklist"
# L2: bridge a filtrar (ajuste se a LAN não for br-lan)
# LAN_BRIDGE="br-lan"
# 1 = só MAC da allowlist passam na bridge; 0 = só blocklist dá DROP
# MAC_ENFORCE=0

LOG_DIR="/var/log/monitor"
STATE_DIR="/tmp/monitor"

# Opcional (checks avancados; ver /usr/lib/monitor/checks.sh)
# DDOS_MAX_PER_IP=200
# PORT_SPIKE_MIN=15
# SPEED_SAMPLE_NOTIFY_SEC=15
# SPEED_TEST_URL="https://proof.ovh.net/files/10Mb.dat"
