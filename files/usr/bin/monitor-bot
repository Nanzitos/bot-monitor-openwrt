#!/bin/sh
# Bot Telegram. Lógica de rede partilhada em /usr/lib/monitor/checks.sh (disparada via /usr/bin/monitor-network).

. /usr/lib/monitor/configs.sh || exit 1
. /usr/lib/monitor/utils.sh
. /usr/lib/monitor/telegram.sh
. /usr/lib/monitor/checks.sh
. /usr/lib/monitor/mac_acl.sh

mkdir -p "$STATE_DIR" "$LOG_DIR"
[ -f "$BLOCKLIST" ] || touch "$BLOCKLIST" 2>/dev/null || true

STATE_FILE="${STATE_DIR}/telegram_flow_state"
AUDIT_LOG="${LOG_DIR}/telegram_audit.log"

log_action() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$AUDIT_LOG" 2>/dev/null || true
}

process_status() {
    checks_ensure_state
    UPTIME=$(uptime | sed 's/^  *//')
    LOAD=$(awk '{print $1,$2,$3}' /proc/loadavg)
    MEM=$(mem_usage_percent)

    WAN1_UP=$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e '@.up')
    WAN2_UP=$(ubus call network.interface.wan2 status 2>/dev/null | jsonfilter -e '@.up')
    WAN1_ST=$([ "$WAN1_UP" = "true" ] && echo "ligada" || echo "desligada")
    WAN2_ST=$([ "$WAN2_UP" = "true" ] && echo "ligada" || echo "desligada")

    IP1="—"
    IP2="—"
    if [ "$WAN1_UP" = "true" ]; then
        D1=$(checks_iface_dev wan)
        if [ -n "$D1" ]; then
            IP1=$(curl -sS --connect-timeout 8 --max-time 15 --interface "$D1" "https://api.ipify.org" 2>/dev/null || true)
            [ -z "$IP1" ] && IP1="?"
        else
            IP1="?"
        fi
    fi
    if [ "$WAN2_UP" = "true" ]; then
        D2=$(checks_iface_dev wan2)
        if [ -n "$D2" ]; then
            IP2=$(curl -sS --connect-timeout 8 --max-time 15 --interface "$D2" "https://api.ipify.org" 2>/dev/null || true)
            [ -z "$IP2" ] && IP2="?"
        else
            IP2="?"
        fi
    fi

    ROUTE=$(ip route get 8.8.8.8 2>/dev/null | awk '{for (i=1;i<=NF;i++) if ($i=="dev") print $(i+1)}')

    send_message "📊 STATUS DO ROUTER

⏱ Uptime
$UPTIME

💻 Load avg: $LOAD
🧠 RAM uso: ~${MEM}%

🌐 WAN (wan): $WAN1_ST
   IP público: $IP1

🌐 WAN2 (wan2): $WAN2_ST
   IP público: $IP2

🔗 Rota até 8.8.8.8: interface ${ROUTE:-?}"
}

process_nao_autorizados() {
    checks_ensure_state
    _f="$STATE_DIR/mac_comando_lista.tmp"
    checks_collect_unknown_neighbors "$_f"
    if [ ! -s "$_f" ]; then
        send_message "✅ Nenhum equipamento fora da mac_allowlist na vizinhança ARP (IPv4) neste momento."
        rm -f "$_f"
        return
    fi
    _n=$(wc -l < "$_f" | tr -d ' ')
    _list=$(checks_format_unknown_plain "$_f")
    rm -f "$_f"

    _head="📋 Fora da allowlist ($_n):

"
    _all="$_head$_list"
    _max=4000
    _tlen=$(printf '%s' "$_all" | wc -c | tr -d ' ')
    if [ "${_tlen:-0}" -le "$_max" ]; then
        send_message "$_all"
        return
    fi
    _p1=$(printf '%s' "$_all" | head -c 3950)
    send_message "$_p1

… (mensagem longa — parte 2 segue)"
    _p2=$(printf '%s' "$_all" | dd bs=1 skip=3950 2>/dev/null)
    [ -n "$_p2" ] && send_message "… continuação:

$_p2"
}

# Prazo /bloqueio_sim|nao → bloqueio automático (ficheiros em block_prompt/)
process_block_prompt_deadlines() {
    checks_ensure_state
    _pd="$STATE_DIR/block_prompt"
    _lim="${BLOCK_PROMPT_SECS:-600}"
    [ -d "$_pd" ] || return 0
    _now=$(date +%s)
    for _fp in "$_pd"/*; do
        [ -f "$_fp" ] || continue
        _slug=$(basename "$_fp")
        MAC=$(echo "$_slug" | tr '_' ':')
        . "$_fp"
        [ "$STATUS" = "pending" ] || continue
        _elapsed=$((_now - ASKED_AT))
        [ "$_elapsed" -lt "$_lim" ] && continue
        [ -f "$BLOCKLIST" ] || touch "$BLOCKLIST"
        monitor_mac_file_remove_line "$ALLOWLIST" "$MAC"
        grep -qxF "$MAC" "$BLOCKLIST" 2>/dev/null || echo "$MAC" >> "$BLOCKLIST"
        rm -f "$_fp"
        monitor_apply_mac_acl
        send_message "MAC $MAC bloqueado automaticamente (sem resposta em $((_lim / 60)) min)."
        log_action "auto-block prazo $MAC"
    done
}

process_bloqueio_cmd() {
    _op="$1"
    _text="$2"
    MAC=$(echo "$_text" | awk '{print $2}' | tr 'A-Z' 'a-z')
    echo "$MAC" | grep -qE '^([0-9a-f]{2}:){5}[0-9a-f]{2}$' || {
        send_message "Uso: /bloqueio_sim aa:bb:cc:dd:ee:ff
ou: /bloqueio_nao aa:bb:cc:dd:ee:ff"
        return
    }
    checks_ensure_state
    _slug=$(echo "$MAC" | tr ':' '_')
    _pf="$STATE_DIR/block_prompt/$_slug"

    if [ ! -f "$_pf" ]; then
        send_message "Nao ha pedido pendente para $MAC (ja tratado ou expirou)."
        return
    fi

    if [ "$_op" = "nao" ]; then
        rm -f "$_pf"
        : > "$STATE_DIR/block_prompt_ignore/$_slug"
        send_message "OK — $MAC nao sera bloqueado por este alerta. Se voltar a aparecer, pediremos de novo."
        log_action "bloqueio_nao $MAC"
        return
    fi

    rm -f "$_pf"
    [ -f "$BLOCKLIST" ] || touch "$BLOCKLIST"
    monitor_mac_file_remove_line "$ALLOWLIST" "$MAC"
    grep -qxF "$MAC" "$BLOCKLIST" 2>/dev/null || echo "$MAC" >> "$BLOCKLIST"
    monitor_apply_mac_acl
    send_message "MAC $MAC adicionado à blocklist (confirmacao manual)."
    log_action "bloqueio_sim $MAC"
}

cancel_flow() {
    rm -f "$STATE_FILE"
    send_message "Operacao cancelada."
    log_action "Operacao cancelada pelo usuario"
}

mac_exists() {
    grep -iq "^$1$" "$ALLOWLIST" 2>/dev/null
}

block_mac_exists() {
    grep -iq "^$1$" "$BLOCKLIST" 2>/dev/null
}

process_flow() {
    [ ! -f "$STATE_FILE" ] && return
    . "$STATE_FILE"

    case "$STEP" in
        "WAIT_MAC")
            echo "$1" | grep -qE '^([A-Fa-f0-9]{2}:){5}[A-Fa-f0-9]{2}$' || {
                send_message "MAC invalido (use aa:bb:cc:dd:ee:ff)."
                return
            }

            MAC=$(echo "$1" | tr '[:upper:]' '[:lower:]')

            if mac_exists "$MAC"; then
                send_message "Este MAC ja esta na allowlist."
                cancel_flow
                return
            fi

            echo "STEP=WAIT_PASS
MAC=$MAC" > "$STATE_FILE"

            send_message "Autorizar este MAC (apenas ficheiro allowlist + nft)?

MAC: $MAC

Digite a senha (SECRET):"
        ;;

        "WAIT_PASS")
            if [ "$1" != "$SECRET" ]; then
                send_message "Senha incorreta. Cancelado."
                log_action "Tentativa com senha incorreta (allowlist) MAC $MAC"
                cancel_flow
                return
            fi

            [ -f "$ALLOWLIST" ] || touch "$ALLOWLIST"
            monitor_mac_file_remove_line "$BLOCKLIST" "$MAC"
            grep -qxF "$MAC" "$ALLOWLIST" 2>/dev/null || echo "$MAC" >> "$ALLOWLIST"
            rm -f "${STATE_DIR}/block_prompt/$(echo "$MAC" | tr ':' '_')"
            rm -f "${STATE_DIR}/block_prompt_ignore/$(echo "$MAC" | tr ':' '_')"

            monitor_apply_mac_acl

            send_message "MAC autorizado (allowlist). Se nft aplicou, trafego segue as regras em /etc/monitor (MAC_ENFORCE / blocklist)."
            log_action "Allowlist + $MAC (sem DHCP estatico)"
            rm -f "$STATE_FILE"
        ;;

        "WAIT_MAC_BLOQ")
            echo "$1" | grep -qE '^([A-Fa-f0-9]{2}:){5}[A-Fa-f0-9]{2}$' || {
                send_message "MAC invalido."
                return
            }

            MAC=$(echo "$1" | tr '[:upper:]' '[:lower:]')

            if block_mac_exists "$MAC"; then
                send_message "Este MAC ja esta na blocklist."
                cancel_flow
                return
            fi

            echo "STEP=WAIT_PASS_BLOQ
MAC=$MAC" > "$STATE_FILE"

            send_message "Bloquear este MAC na bridge (DROP nft)?

MAC: $MAC

Retira da allowlist se estiver. Digite a senha:"
        ;;

        "WAIT_PASS_BLOQ")
            if [ "$1" != "$SECRET" ]; then
                send_message "Senha incorreta. Cancelado."
                log_action "Tentativa com senha incorreta (blocklist) MAC $MAC"
                cancel_flow
                return
            fi

            [ -f "$BLOCKLIST" ] || touch "$BLOCKLIST"
            monitor_mac_file_remove_line "$ALLOWLIST" "$MAC"
            grep -qxF "$MAC" "$BLOCKLIST" 2>/dev/null || echo "$MAC" >> "$BLOCKLIST"
            rm -f "${STATE_DIR}/block_prompt/$(echo "$MAC" | tr ':' '_')"

            monitor_apply_mac_acl

            send_message "MAC bloqueado (blocklist + nft). Retirado da allowlist se existia."
            log_action "Blocklist + $MAC"
            rm -f "$STATE_FILE"
        ;;
    esac
}

handle_command() {
    _text="$1"

    case "$_text" in
        "/status")
            process_status
        ;;
        "/adiciona_mac")
            echo "STEP=WAIT_MAC" > "$STATE_FILE"
            send_message "Envie o MAC (aa:bb:cc:dd:ee:ff). Depois pediremos a senha. Sem reserva DHCP — só allowlist + nft. /cancelar"
        ;;
        "/bloqueia_mac")
            echo "STEP=WAIT_MAC_BLOQ" > "$STATE_FILE"
            send_message "MAC a bloquear (aa:bb:...). Remove da allowlist e acrescenta à blocklist (nft DROP). /cancelar"
        ;;
        "/cancelar")
            cancel_flow
        ;;
        "/checks")
            [ -x /usr/bin/monitor-network ] && /usr/bin/monitor-network all >/dev/null 2>&1 &
            send_message "Ciclo completo (monitor-network all) em background."
        ;;
        "/check_rede")
            [ -x /usr/bin/monitor-network ] && /usr/bin/monitor-network tick >/dev/null 2>&1 &
            send_message "Checagem rede (tick) em background."
        ;;
        "/check_ssh")
            [ -x /usr/bin/monitor-network ] && /usr/bin/monitor-network ssh >/dev/null 2>&1 &
            send_message "Checagem SSH (log) em background."
        ;;
        "/check_scan")
            [ -x /usr/bin/monitor-network ] && /usr/bin/monitor-network scan >/dev/null 2>&1 &
            send_message "Checagem scan interno (MONITOR_DROP) em background."
        ;;
        "/check_ddos")
            [ -x /usr/bin/monitor-network ] && /usr/bin/monitor-network ddos-notify >/dev/null 2>&1 &
            send_message "Diagnostico DDoS/conexoes em background (Telegram)."
        ;;
        "/check_portas")
            [ -x /usr/bin/monitor-network ] && /usr/bin/monitor-network portscan >/dev/null 2>&1 &
            send_message "Pico de porta (MONITOR_DROP) em background."
        ;;
        "/check_velocidade")
            [ -x /usr/bin/monitor-network ] && /usr/bin/monitor-network speed-notify >/dev/null 2>&1 &
            send_message "Medicao (~15s/link + download HTTP por WAN) em background."
        ;;
        "/nao_autorizados"|"/macs_bloqueados")
            process_nao_autorizados
        ;;
        /bloqueio_sim*)
            process_bloqueio_cmd sim "$_text"
        ;;
        /bloqueio_nao*)
            process_bloqueio_cmd nao "$_text"
        ;;
        "/help"|"/ajuda"|"/start")
            send_message "📋 MONITOR — Ajuda

📊 Estado
  /status — uptime, load, RAM, IP público WAN + WAN2, rota default

🛡 MAC (allowlist / blocklist + nft)
  /adiciona_mac — autorizar MAC (só ficheiro; sem DHCP estático)
  /bloqueia_mac — bloquear MAC (DROP na bridge se nft OK)
  Novo MAC detetado: pergunta com /bloqueio_sim ou /bloqueio_nao (10 min → bloqueio auto)
  /nao_autorizados — listar fora da allowlist
  /cancelar — cancelar fluxo

🔧 Checagens (background → alertas Telegram)
  /checks — todas as checagens de rede
  /check_rede — WAN, failover, IP, MAC
  /check_ssh — falhas SSH no log
  /check_scan — MONITOR_DROP (scan interno)
  /check_ddos — diagnóstico conexões (conntrack/netstat)
  /check_portas — pico de porta (MONITOR_DROP)
  /check_velocidade — tráfego no link + teste HTTP por WAN

ℹ️ /help"
        ;;
        *)
            process_flow "$_text"
        ;;
    esac
}

process_updates() {
    process_block_prompt_deadlines

    RESPONSE=$(get_updates) || RESPONSE=""

    OK=$(echo "$RESPONSE" | jsonfilter -e '@.ok' 2>/dev/null)
    if [ "$OK" != "true" ]; then
        monitor_log "telegram getUpdates: resposta nao-ok ou vazia"
        sleep 5
        return
    fi

    i=0
    LAST_SEEN=""

    while [ "$i" -lt 64 ]; do
        UPDATE_ID=$(echo "$RESPONSE" | jsonfilter -e "@.result[$i].update_id" 2>/dev/null)
        [ -z "$UPDATE_ID" ] && break

        LAST_SEEN=$UPDATE_ID

        CHAT=$(echo "$RESPONSE" | jsonfilter -e "@.result[$i].message.chat.id" 2>/dev/null)
        SENDER=$(echo "$RESPONSE" | jsonfilter -e "@.result[$i].message.from.id" 2>/dev/null)
        TEXT=$(echo "$RESPONSE" | jsonfilter -e "@.result[$i].message.text" 2>/dev/null)

        if [ "$CHAT" != "$TELEGRAM_CHAT_ID" ] || [ "$SENDER" != "$TELEGRAM_USER_ID" ]; then
            i=$((i + 1))
            continue
        fi

        if [ -n "$TEXT" ]; then
            handle_command "$TEXT"
        fi

        i=$((i + 1))
    done

    if [ -n "$LAST_SEEN" ]; then
        echo "$LAST_SEEN" > "${STATE_DIR}/telegram_last_update"
    fi
}

while true; do
    process_updates
    sleep 2
done
