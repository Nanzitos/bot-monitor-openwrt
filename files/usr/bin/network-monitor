#!/bin/sh

############################
# network-monitor v2.2 TODO change name to monitor-network
# OpenWrt / config.env / libs
############################

. /usr/lib/monitor/configs.sh || exit 1
. /usr/lib/monitor/utils.sh
. /usr/lib/monitor/telegram.sh

mkdir -p "$STATE_DIR" "$LOG_DIR"

WAN_STATE="$STATE_DIR/wan_state"
FAILOVER_STATE="$STATE_DIR/failover_state"
IP_STATE="$STATE_DIR/public_ip"
SSH_STATE="$STATE_DIR/ssh_alert"
DAILY_STATE="$STATE_DIR/daily_sent"
SCAN_STATE="$STATE_DIR/scan_alert"
WIFI_CACHE="$STATE_DIR/wifi_stations.cache"

############################
# LOG CACHE (Performance)
############################

LOG_CACHE="$(logread)"
CURRENT_MIN="$(date '+%b %d %H:%M')"
CURRENT_HOUR="$(date '+%b %d %H')"

############################
# TELEGRAM (HTML)
############################

log_event() {
    LEVEL="$1"
    MESSAGE="$2"

    FINAL_MESSAGE="📡 <b>MONITOR</b> | <b>$LEVEL</b>

$MESSAGE"

    send_message_html "$FINAL_MESSAGE" || monitor_log "telegram: log_event falhou ($LEVEL)"
}

############################
# WiFi: cache por ciclo (menos iw)
############################

build_wifi_cache() {
    _tmp="${WIFI_CACHE}.tmp"
    : > "$_tmp"
    for iface in $(iw dev 2>/dev/null | awk '$1=="Interface"{print $2}'); do
        SSID_JSON=$(ubus call "hostapd.$iface" get_status 2>/dev/null)
        WIFI_SSID=$(echo "$SSID_JSON" | jsonfilter -e '@.ssid' 2>/dev/null)
        [ -z "$WIFI_SSID" ] && WIFI_SSID="unknown"
        iw dev "$iface" station dump 2>/dev/null | awk -v ifc="$iface" -v ssid="$WIFI_SSID" \
            '$1=="Station"{print tolower($2)"|"ifc"|"ssid}' >> "$_tmp"
    done
    mv "$_tmp" "$WIFI_CACHE" 2>/dev/null || rm -f "$_tmp"
}

############################
# WAN STATUS
############################

check_wan() {
    TODO: Run Every 5 minutes, create a comando in monitor-bot to trigger manualy if you want
    WAN1=$(ubus call network.interface.wan status | jsonfilter -e '@.up')
    WAN2=$(ubus call network.interface.wan2 status 2>/dev/null | jsonfilter -e '@.up')

    WAN1=${WAN1:-false}
    WAN2=${WAN2:-false}

    [ -f "$WAN_STATE" ] || echo "WAN1_OLD=unknown WAN2_OLD=unknown" > "$WAN_STATE"
    . "$WAN_STATE"

    CURRENT_WAN1=$([ "$WAN1" = "true" ] && echo "online" || echo "offline")
    CURRENT_WAN2=$([ "$WAN2" = "true" ] && echo "online" || echo "offline")

    [ "$CURRENT_WAN1" != "$WAN1_OLD" ] && log_event "INFO" "WAN1 $CURRENT_WAN1"
    [ "$CURRENT_WAN2" != "$WAN2_OLD" ] && log_event "INFO" "WAN2 $CURRENT_WAN2"

    echo "WAN1_OLD=$CURRENT_WAN1 WAN2_OLD=$CURRENT_WAN2" > "$WAN_STATE"
}

############################
# FAILOVER
############################

check_failover() {
    #TODO Run Every 5 minutes, create a comando in monitor-bot to trigger manualy if you want
    ROUTE=$(ip route get 8.8.8.8 2>/dev/null | awk '/dev/ {print $5}')

    if [ "$ROUTE" = "wan2" ]; then
        [ ! -f "$FAILOVER_STATE" ] && \
        log_event "WARNING" "Failover ativo (WAN2 em uso)." && \
        touch "$FAILOVER_STATE"
    else
        [ -f "$FAILOVER_STATE" ] && \
        log_event "INFO" "WAN primária restaurada." && \
        rm -f "$FAILOVER_STATE"
    fi
}

############################
# PUBLIC IP CHANGE
############################

check_public_ip() {
    #TODO: Run Every 5 minutes and check all wan interface ex: wan, wan2, create a comando in monitor-bot to trigger manualy if you want
    CURRENT_IP=$(curl -sS --connect-timeout 8 --max-time 15 "https://api.ipify.org" 2>/dev/null) || return 0
    [ -z "$CURRENT_IP" ] && return 0
    echo "$CURRENT_IP" | grep -qE '^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$' || return 0

    if [ ! -f "$IP_STATE" ]; then
        echo "$CURRENT_IP" > "$IP_STATE"
    else
        OLD_IP=$(cat "$IP_STATE")

        if [ "$CURRENT_IP" != "$OLD_IP" ]; then
            log_event "WARNING" "IP Público REAL alterado

Antigo: $OLD_IP
Novo: $CURRENT_IP"

            echo "$CURRENT_IP" > "$IP_STATE"
        fi
    fi
}

############################
# SSH BRUTE FORCE (TEMPORAL)
############################

check_ssh() {
    #TODO Run Every 10 minutes, create a comando in monitor-bot to trigger manualy if you want
    COUNT=$(echo "$LOG_CACHE" | \
        grep "$CURRENT_HOUR" | \
        grep "Failed password" | wc -l)

    if [ "$COUNT" -gt 10 ]; then
        [ ! -f "$SSH_STATE" ] && \
        log_event "CRITICAL" "$COUNT tentativas SSH na última hora." && \
        touch "$SSH_STATE"
    else
        rm -f "$SSH_STATE"
    fi
}

############################
# NAC / allowlist
############################

check_mac() {
    #TODO: Run every 5 minutes, create a comando in monitor-bot to trigger manualy if you want
    [ -f "$ALLOWLIST" ] || touch "$ALLOWLIST"

    build_wifi_cache

    ip neigh show | while read -r IP _ DEV _ MAC STATE _; do
        echo "$IP" | grep -qE '^[0-9]+\.' || continue
        echo "$MAC" | grep -q ":" || continue
        [ "$STATE" = "FAILED" ] && continue

        MAC=$(echo "$MAC" | tr 'A-Z' 'a-z')

        VLAN_NAME="UNKNOWN"
        case "$DEV" in
            br-lan.30) VLAN_NAME="USERS" ;;
            br-lan.40) VLAN_NAME="IOT" ;;
            br-lan.50) VLAN_NAME="GUEST" ;;
            br-lan.20) VLAN_NAME="LAB" ;;
            br-lan.1)  VLAN_NAME="LAN" ;;
        esac

        HOSTNAME=$(awk -v mac="$MAC" 'tolower($2)==mac {print $4}' /tmp/dhcp.leases 2>/dev/null)
        [ -z "$HOSTNAME" ] && HOSTNAME="desconhecido"

        CONNECTION_TYPE="Cabo"
        WIFI_SSID="N/A"
        _wline=$(grep -F "${MAC}|" "$WIFI_CACHE" 2>/dev/null | head -n1)
        if [ -n "$_wline" ]; then
            CONNECTION_TYPE="WiFi"
            WIFI_SSID=$(echo "$_wline" | cut -d'|' -f3)
            [ -z "$WIFI_SSID" ] && WIFI_SSID="SSID_desconhecido"
        fi

        if ! grep -iq "^$MAC$" "$ALLOWLIST"; then
            log_event "CRITICAL" "Novo dispositivo detectado

IP: $IP
MAC: $MAC
Hostname: $HOSTNAME
VLAN: $VLAN_NAME
Conexao: $CONNECTION_TYPE
WiFi Rede: $WIFI_SSID
Estado ARP: $STATE"
        fi
    done
}

############################
# INTERNAL SCAN (TEMPORAL)
# Marca de firewall: MONITOR_DROP (ajuste regras iptables/nft se usava SEBASTIANA_DROP)
############################

check_internal_scan() {
    #TODO Run Every 2hours, create a comando in monitor-bot to trigger manualy if you want
    COUNT=$(echo "$LOG_CACHE" | \
        grep "$CURRENT_MIN" | \
        grep "MONITOR_DROP" | wc -l)

    if [ "$COUNT" -gt 20 ]; then
        if [ ! -f "$SCAN_STATE" ]; then
            ATTACKER=$(echo "$LOG_CACHE" | \
                grep "$CURRENT_MIN" | \
                grep "MONITOR_DROP" | \
                awk '{for(i=1;i<=NF;i++) if($i ~ /SRC=/){split($i,a,"="); print a[2]}}' | \
                sort | uniq -c | sort -nr | head -n1)

            log_event "CRITICAL" "Possível scan interno detectado.

Eventos no último minuto: $COUNT
Principal origem: $ATTACKER"

            touch "$SCAN_STATE"
        fi
    else
        rm -f "$SCAN_STATE"
    fi
}

# TODO: Create a comand to check if have an ddos attack, maybe check for many connections from same ip in short time, or many connections to same port, etc.
# TODO: Create a comand to check if have an scan in specific port, maybe check for many connections to same port in short time, etc.
# TODO: Create a comand to check speed internet in all interfaces wan and wan2.

############################
# DAILY REPORT
############################

daily_report() {
    #TODO: Run  everyDay At 08:00, adjust if your setup doesn't run this script in a cron
    HOUR=$(date +"%H")

    if [ "$HOUR" = "08" ] && [ ! -f "$DAILY_STATE" ]; then
        LOAD=$(uptime | awk -F'load average:' '{ print $2 }')
        MEM=$(mem_usage_percent)

        log_event "INFO" "Daily Report

CPU Load:$LOAD
RAM:${MEM}%"

        touch "$DAILY_STATE"
    fi

    [ "$HOUR" = "09" ] && rm -f "$DAILY_STATE"
}

############################
# EXECUTION
############################

check_wan
check_failover
check_public_ip
check_ssh
check_mac
check_internal_scan
daily_report


# TODO Create a cron to run process in your setup time