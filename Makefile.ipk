# Gera ipk-out/monitor.ipk via Docker (Ubuntu + SDK OpenWrt).
# Na raiz do repositório:
#   make -f Makefile.ipk ipk
# ou simplesmente (alvo predefinido):
#   make -f Makefile.ipk
#
# Exige Docker. SDK predefinido: mediatek/filogic (SDK_URL em docker/docker-compose.ipk.yml).

.PHONY: ipk help default

# Primeiro alvo = predefinido ao correr make -f Makefile.ipk sem argumentos
default: ipk

help:
	@echo "Gerar o pacote:"
	@echo "  make -f Makefile.ipk ipk"
	@echo "  make -f Makefile.ipk       # igual (alvo predefinido: ipk)"
	@echo ""
	@echo "Equivalente manual:"
	@echo "  mkdir -p ipk-out && docker compose -f docker/docker-compose.ipk.yml build \\"
	@echo "    && docker compose -f docker/docker-compose.ipk.yml run --rm monitor-ipk"

ipk:
	mkdir -p ipk-out
	docker compose -f docker/docker-compose.ipk.yml build
	docker compose -f docker/docker-compose.ipk.yml run --rm monitor-ipk
